[Unit]
Description=Recovery drive: sync btrdasd state and configuration from the newest received snapshot
ConditionPathExists=/etc/das-backup/recovery-drive
After=local-fs.target plymouth-start.service
Before=display-manager.service btrdasd-helper.service plymouth-quit.service plymouth-quit-wait.service

[Service]
Type=oneshot
ExecStart=/usr/lib/das-backup/das-recovery-state-sync.sh
RemainAfterExit=yes
# 2 = no received das-state snapshot yet (first boot before any backup): not a
# failure, and a failed unit would be restarted by cachyos-sentinel. Load-bearing.
SuccessExitStatus=2

[Install]
WantedBy=multi-user.target
