[Unit]
Description=DAS Backup - BTRFS incremental backup to DAS enclosure
Documentation=https://github.com/TheBoscoClub/DAS-Backup-Manager
After=local-fs.target
# Retirement and expiry are dated by the clock (see caldate::untrusted_clock).
Wants=time-sync.target
After=time-sync.target
# Only run if DAS is likely connected (btrdasd setup configures the actual glob)
ConditionPathExistsGlob=/dev/disk/by-id/usb-*

[Service]
Type=oneshot
# Exit semantics (bd DAS-Backup-Manager-d1r):
#   0 = the run executed and nothing failed (a warning still exits 0), or it
#       skipped because another backup was running.
#   3 = the run began its work and something failed: btrbk failed for some or
#       all targets, any operation failed, or it aborted on a target's or a
#       source's state. Its report says what (an abort sends a short ABORTED
#       report), the history has it as failed, and the journal has status=3.
#   1 = could not start: nothing was mounted or sent (config, btrdasd missing,
#       arguments, not root, a lock it could not open or take).
#   130/143 = stopped by SIGINT/SIGTERM.
# SuccessExitStatus=3: what made a run fail is usually still there ten minutes
# later (an absent drive). With the unit failed, cachyos-sentinel would start
# a whole new backup about every ten minutes; its 3-per-600 s limiter cannot
# brake a loop that slow. Exit 1 still fails the unit, in seconds.
SuccessExitStatus=3
ExecStart=@DAS_SCRIPT_DIR@/backup-run.sh
StandardOutput=journal
StandardError=journal
# Nice and ionice for background operation
Nice=19
IOSchedulingClass=idle
# Timeout after 6 hours (initial backup can take 3+ hours)
TimeoutStartSec=21600

[Install]
WantedBy=multi-user.target
