#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_configure:
	cmake -B build -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release

override_dh_auto_build:
	cmake --build build

override_dh_auto_install:
	DESTDIR=$(CURDIR)/debian/das-backup-manager cmake --install build

# The helper is D-Bus activated (SystemdService= in its activation file), so
# installing the package enables and starts nothing: dh_installsystemd would
# otherwise enable the unit (it has an [Install] section) and start or restart
# it, as root, at every install and upgrade. `btrdasd setup --upgrade` restarts
# it after an update.
override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start

override_dh_shlibdeps:
	dh_shlibdeps --dpkg-shlibdeps-params=--ignore-missing-info || true
