# Maintainer: TheBoscoClub <theboscoclub@users.noreply.github.com>
pkgname=das-backup-manager
pkgver=0.7.23.0
pkgrel=1
pkgdesc='DAS backup manager with btrbk integration, SQLite FTS5 content indexing, and KDE Plasma GUI'
arch=('x86_64')
url='https://github.com/TheBoscoClub/DAS-Backup-Manager'
license=('MIT')
depends=('btrbk' 'btrfs-progs' 'smartmontools' 'bash' 'util-linux'
         'qt6-base' 'qt6-charts' 'kcoreaddons' 'ki18n' 'kxmlgui'
         'kconfigwidgets' 'kiconthemes' 'kcrash' 'kio'
         'knotifications' 'kstatusnotifieritem' 'hicolor-icon-theme')
# The last six are for recovery-os-vm.sh; its VM names edk2-ovmf's Arch paths.
optdepends=('s-nail: email backup reports (mailx)'
            'mbuffer: buffered btrbk stream transfers'
            'libvirt: recovery-os-vm.sh, a recovery drive updated in a VM'
            'qemu-base: the recovery-os-updater VM'
            'edk2-ovmf: UEFI firmware for the recovery-os-updater VM'
            'virt-viewer: console of the recovery-os-updater VM'
            'imagemagick: recovery-os-vm.sh screenshot'
            'jq: recovery-os-vm.sh reads the boot record of a recovery OS')
makedepends=('rust' 'cmake' 'extra-cmake-modules' 'qt6-tools')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "DAS-Backup-Manager-$pkgver"

    # Strip GCC LTO flags — GCC LTO bitcode is incompatible with LLVM's lld
    # linker used by rustc, causing undefined sqlite3_* symbols when linking
    # the bundled libsqlite3-sys static archive
    export CFLAGS="${CFLAGS//-flto=auto/}"
    export CXXFLAGS="${CXXFLAGS//-flto=auto/}"
    export LDFLAGS="${LDFLAGS//-flto=auto/}"

    # btrdasd: CMake below is told -DBUILD_INDEXER=OFF, so cargo builds it
    # here. btrdasd-helper is CMake's (BUILD_HELPER stays ON).
    cargo build --release --bin btrdasd --manifest-path indexer/Cargo.toml

    # The D-Bus helper, scripts and GUI, via CMake
    cmake -B build -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_INDEXER=OFF
    cmake --build build
}

package() {
    cd "DAS-Backup-Manager-$pkgver"

    # Everything CMake builds: scripts, the GUI with its icon and desktop
    # entry, and btrdasd-helper with its D-Bus, polkit and unit files. No
    # backup unit: `btrdasd setup` writes those on the host
    DESTDIR="$pkgdir" cmake --install build

    # btrdasd, from the cargo build above
    install -Dm755 "indexer/target/release/btrdasd" "$pkgdir/usr/bin/btrdasd"

    # License
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
