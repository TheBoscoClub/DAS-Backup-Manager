# ctest gui-notifyrc: every KNotification event id the GUI sends must have an
# [Event/<id>] group in btrdasd-gui.notifyrc (bd DAS-Backup-Manager-w1a0).
# Usage: cmake -DGUI_DIR=<gui source dir> -P check-notifyrc.cmake
file(READ "${GUI_DIR}/src/notifyevents.h" _hdr)
string(REGEX MATCHALL "QStringLiteral\\(\"[A-Za-z0-9_]+\"\\)" _lits "${_hdr}")
if(NOT _lits)
    message(FATAL_ERROR "no event ids found in src/notifyevents.h")
endif()
set(_bad "")
set(_rc "")
if(EXISTS "${GUI_DIR}/btrdasd-gui.notifyrc")
    file(READ "${GUI_DIR}/btrdasd-gui.notifyrc" _rc)
endif()
foreach(_l IN LISTS _lits)
    string(REGEX REPLACE "QStringLiteral\\(\"([A-Za-z0-9_]+)\"\\)" "\\1" _id "${_l}")
    string(FIND "${_rc}" "[Event/${_id}]" _pos)
    if(_pos EQUAL -1)
        string(APPEND _bad " ${_id}")
    endif()
endforeach()
# No call site may bypass the header with its own literal id.
file(GLOB _srcs "${GUI_DIR}/src/*.cpp")
foreach(_f IN LISTS _srcs)
    file(READ "${_f}" _txt)
    string(REPLACE ";" "," _txt "${_txt}")
    if(_txt MATCHES "KNotification[^,]*QStringLiteral")
        string(APPEND _bad " literal-id-in:${_f}")
    endif()
endforeach()
if(_bad)
    message(FATAL_ERROR "notifyrc check failed, missing/unsafe:${_bad}")
endif()
message(STATUS "notifyrc covers all event ids")
