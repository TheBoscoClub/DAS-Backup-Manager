[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = usr/lib/modules/*/vmlinuz
Target = usr/lib/initcpio/*
Target = boot/*

[Action]
Description = Syncing primary ESP to backup NVMe ESP (structure-aware, checksum-based)...
When = PostTransaction
Exec = /usr/local/bin/esp-sync.sh
Depends = coreutils
